rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isInternal() { return role() in ['Owner','Admin','Accounting','PM','Field','ReadOnly']; }
    function isAdmin() { return role() in ['Owner','Admin']; }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{col}/{id} {
      allow read: if signedIn();
      allow write: if isInternal();
    }

    match /templates/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
