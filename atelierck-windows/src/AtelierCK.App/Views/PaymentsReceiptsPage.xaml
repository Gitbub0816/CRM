<Page x:Class="AtelierCK.Views.PaymentsReceiptsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="20" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Payments / Receipts" FontSize="30" Foreground="#C9A227"/>
    <Grid Grid.Row="1" ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListView>
        <ListViewItem Content="Payment PAY-0001 | Invoice INV-000001 | $1,000.00"/>
      </ListView>
      <StackPanel Grid.Column="1" Spacing="8">
        <TextBox Header="Amount"/>
        <ComboBox Header="Method">
          <ComboBoxItem Content="Cash"/><ComboBoxItem Content="Card"/><ComboBoxItem Content="Bank Transfer"/>
        </ComboBox>
        <Button Content="Post Partial Payment"/>
        <Button Content="Open Receipt PDF"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
