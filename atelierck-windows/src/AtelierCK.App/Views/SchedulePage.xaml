<Page x:Class="AtelierCK.Views.SchedulePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="20" RowSpacing="10">
    <TextBlock Text="Schedule" FontSize="30" Foreground="#C9A227"/>
    <StackPanel Margin="0,50,0,0" Spacing="8">
      <DatePicker Header="Appointment Date"/>
      <TimePicker Header="Start"/>
      <TimePicker Header="End"/>
      <ComboBox Header="Status"><ComboBoxItem Content="Requested"/><ComboBoxItem Content="Approved"/><ComboBoxItem Content="Completed"/></ComboBox>
      <Button Content="Save Appointment"/>
    </StackPanel>
  </Grid>
</Page>
