<Page x:Class="AtelierCK.Views.TemplateStudioPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AtelierCK.Controls">
  <Grid Padding="20" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="280"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Spacing="8">
      <TextBlock Text="Components" FontSize="22" Foreground="#C9A227"/>
      <ListView>
        <ListViewItem Content="Header"/>
        <ListViewItem Content="ClientBlock"/>
        <ListViewItem Content="ProjectBlock"/>
        <ListViewItem Content="LineItemsTable"/>
        <ListViewItem Content="TotalsBlock"/>
        <ListViewItem Content="TermsBlock"/>
        <ListViewItem Content="SignatureBlock"/>
        <ListViewItem Content="PaymentInstructions"/>
        <ListViewItem Content="Footer"/>
        <ListViewItem Content="Watermark"/>
      </ListView>
    </StackPanel>

    <controls:TemplateCanvasControl Grid.Column="1"/>

    <StackPanel Grid.Column="2" Spacing="10">
      <TextBlock Text="Properties" FontSize="22" Foreground="#C9A227"/>
      <TextBox Header="Label"/>
      <TextBox Header="Alignment"/>
      <TextBox Header="Font Size"/>
      <CheckBox Content="Show Signature"/>
      <Button Content="Save Draft"/>
      <Button Content="Publish Version"/>
      <Button Content="Request Server Preview"/>
    </StackPanel>
  </Grid>
</Page>
