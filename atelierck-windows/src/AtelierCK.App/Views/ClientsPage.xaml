<Page x:Class="AtelierCK.Views.ClientsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="20" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Clients" FontSize="30" Foreground="#C9A227"/>
    <Grid Grid.Row="1" ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListView>
        <ListViewItem Content="Maison Rouge | client@example.com | 555-0100"/>
      </ListView>
      <StackPanel Grid.Column="1" Spacing="8">
        <TextBox Header="Name"/>
        <TextBox Header="Email"/>
        <TextBox Header="Phone"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Create"/>
          <Button Content="Update"/>
          <Button Content="Archive"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
